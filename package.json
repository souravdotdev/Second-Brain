{
  "name": "second-brain",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "db:generate": "turbo run db:generate --filter=@second-brain/db",
    "db:migrate": "turbo run db:migrate --filter=@second-brain/db",
    "db:studio": "turbo run db:studio --filter=@second-brain/db",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "turbo": "latest",
    "typescript": "^6.0.3"
  }
}
